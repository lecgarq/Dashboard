    {
      "col_0": "bucketKeystring",
      "col_1": "The bucket key of the bucket that contains the objects you are operating on."
    },
    {
      "col_0": "useAccelerationboolean",
      "col_1": "true : (Default) Generates a faster S3 signed URL using Transfer Acceleration.\nfalse: Generates a standard S3 signed URL."
