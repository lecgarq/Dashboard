      "col_1": "data:write data:create"
    },
    {
      "col_0": "Data Format",
      "col_1": "JSON"
    },
    {
      "col_0": "Authorization*string",
      "col_1": "Must be Bearer <token>, where <token> is a two-legged access token obtained via a Client Credentials Grant flow."
    },
    {
      "col_0": "Content-Type*string",
      "col_1": "Must be application/json"
