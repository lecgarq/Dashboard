    },
    {
      "col_0": "requests*array: object",
      "col_1": "An array where each element is an object containing information needed to generate a signed S3 upload URL."
    },
    {
      "col_0": "objectKey*string",
      "col_1": "A URL-encoded human friendly name of the object to upload."
    },
    {
      "col_0": "firstPartint",
      "col_1": "The index of first chunk to be uploaded."
