  "codeExamples": [
    {
      "raw": "InventorCoreConsole.exe /s \"custom_script.iLogicVb\""
    },
    {
      "raw": "InventorCoreConsole.exe /al \"plugin_to_use\" /i \"input_file.ipt\""
    },
    {
      "raw": "/i \"input_file\" /al \"plugin_to_use\" /s \"script_file\" /p \\\ncommand subcommand /property val val2 \\\n/verbose /file file.txt /additionalValue1 1"
    },
    {
      "raw": "using Autodesk.Forge.DesignAutomation.Inventor.Utils.Helpers;"
    },
    {
      "raw": "int intValue = nameValueMap.AsInt(\"additionalValue1\")\n// Do something ..."
    },
    {
      "raw": "string strValue = nameValueMap.AsString(\"additionalValue1\")\n// Do something ..."
    },
    {
      "raw": "/i \"input_file\" /al \"plugin_to_use\" /s \"script_file\" /p \\\ncommand subcommand /property val val2 /verbose /file file.txt \\\n/collection 1.33, 2.5, 3.7, 41.5, 133.7, 650.832, 7.145"
    },
    {
      "raw": "double[] doubleCollection = nameValueMap.AsDoubleCollection(\"/collection\");\n\nforeach (double value in doubleCollection)\n{\n    Console.writeLine(value)\n}"
    },
    {
      "raw": "1.33\n2.5\n3.7\n41.5\n133.7\n650.832\n7.145"
    },
    {
      "raw": "/i \"input_file\" /al \"plugin_to_use\" /s \"script_file\" /p \\\ncommand subcommand /property val val2 \\\n/verbose /file file.txt /additionalValue1 TRUE \\\n/additionalValue2 VALUE_TWO"
    },
    {
      "raw": "public enum MyEnum\n{\n    VALUE_ONE,\n    VALUE_TWO,\n    VALUE_THREE,\n    VALUE_FOUR,\n    VALUE_FIVE\n}"
    },
    {
      "raw": "bool boolValue = nameValueMap.AsBool(\"additionalValue1\")\n// boolValue is true\n// Do something ...\n\nMyEnum enumValue = nameValueMap.AsEnum<MyEnum>(\"additionalValue2\")\n// the variable enumValue is set to VALUE_TWO\n// Do something ..."
    },
    {
      "raw": "TryGetValueAs<type>(string index, out type outValue)\n\nGetValueAsCollection<type>(string index)"
    },
    {
      "raw": "$(engine.path)\\\\InventorCoreConsole.exe /al \"$(appbundles[{Constants.Activity.Id}].path)\" \\\n/i \"$(args[{Constants.Parameters.InventorDoc}].path)\" \\\n/customCollection \"$(args[{Constants.Parameters.CollectionParam}].value)\" \\\n/customSwitch \\\n/customArg customValue \\\n/intParam \"$(args[{Constants.Parameters.IntParam}].value)\" \\\n/doubleParam \"$(args[{Constants.Parameters.DoubleParam}].value)\""
    },
    {
      "raw": "bool customSwitch = map.HasKey(\"customSwitch\");\nint intParam = map.AsInt(\"intParam\");\ndouble doubleParam = map.AsDouble(\"doubleParam\");\nvar customCollection = map.AsStringCollection(\"customCollection\");\nvar customArg = map.Item[\"customArg\"];"
    }
