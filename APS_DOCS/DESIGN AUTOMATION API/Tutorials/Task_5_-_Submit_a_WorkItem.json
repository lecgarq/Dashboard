        {
          "HTTP Request": "POST /workitems",
          "Description": "Creates a new WorkItem and queues it for processing."
        }
      ]
    }
  ],
  "codeExamples": [
    {
      "raw": "curl -X POST \\\n    'https://developer.api.autodesk.com/da/us-east/v3/workitems' \\\n    -H 'Authorization: Bearer <YOUR_ACCESS_TOKEN>' \\\n    -H 'Content-Type: application/json' \\\n    -d '{\n            \"activityId\":\"<YOUR_NICKNAME>.ExecuteMaxscript+tutorial\",\n            \"arguments\":{\n                \"InputMaxScene\":{\n                    \"url\":\"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_ZIP_FILE>\",\n                    \"pathInZip\":\"<RELATIVE_PATH_TO_MAX_SCENE_INSIDE_ZIP_FILE>\",\n                    \"verb\":\"get\",\n                    \"headers\":{\n                        \"Authorization\":\"Bearer <YOUR_ACCESS_TOKEN>\"\n                    }\n                },\n                \"MaxscriptToExecute\":{\n                    \"url\":\"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_MAXSCRIPT_FILE>\",\n                    \"verb\":\"get\",\n                    \"headers\":{\n                        \"Authorization\":\"Bearer <YOUR_ACCESS_TOKEN>\"\n                    }\n                },\n                \"OutputZip\":{\n                    \"url\":\"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_OUTPUT_FILE>\",\n                    \"verb\":\"put\",\n                    \"headers\":{\n                        \"Authorization\":\"Bearer <YOUR_ACCESS_TOKEN>\"\n                    }\n                }\n            }\n        }'",
      "parsed": {
        "activityId": "<YOUR_NICKNAME>.ExecuteMaxscript+tutorial",
        "arguments": {
          "InputMaxScene": {
            "url": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_ZIP_FILE>",
            "pathInZip": "<RELATIVE_PATH_TO_MAX_SCENE_INSIDE_ZIP_FILE>",
            "verb": "get",
            "headers": {
              "Authorization": "Bearer <YOUR_ACCESS_TOKEN>"
            }
          },
          "MaxscriptToExecute": {
            "url": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_MAXSCRIPT_FILE>",
            "verb": "get",
            "headers": {
              "Authorization": "Bearer <YOUR_ACCESS_TOKEN>"
            }
          },
          "OutputZip": {
            "url": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_OUTPUT_FILE>",
            "verb": "put",
            "headers": {
              "Authorization": "Bearer <YOUR_ACCESS_TOKEN>"
            }
          }
        }
      }
    },
    {
      "raw": "{\n    \"status\": \"pending\",\n    \"stats\": {\n        \"timeQueued\": \"2023-10-05T03:54:15.0618534Z\"\n    },\n    \"id\": \"<YOUR_WORKITEM_ID>\"\n}",
      "parsed": {
