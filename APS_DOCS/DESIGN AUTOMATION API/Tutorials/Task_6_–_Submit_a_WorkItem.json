  "title": "Task 6 – Submit a WorkItem",
  "tables": [
    {
      "label": "",
      "headers": [
        "HTTP Request",
        "Description"
      ],
      "rows": [
        {
          "HTTP Request": "POST /workitems",
          "Description": "Creates a new WorkItem and queues it for processing."
        },
        {
          "HTTP Request": "GET /workitems/{id}",
          "Description": "Gets the status of a specific WorkItem."
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Attribute",
        "Description"
      ],
      "rows": [
        {
          "Attribute": "status",
          "Description": "Indicates if execution is pending, successful, failed or cancelled."
        },
        {
          "Attribute": "reportUrl",
          "Description": "The URL to get the report log for this WorkItem’s execution."
        }
      ]
    }
  ],
  "codeExamples": [
    {
      "raw": "curl -X POST \\\n  'https://developer.api.autodesk.com/da/us-east/v3/workitems' \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer <YOUR_ACCESS_TOKEN>' \\\n  -d '{\n          \"activityId\": \"<YOUR_APP_NICKNAME>.ChangeParamActivity+my_current_version\",\n          \"arguments\": {\n                  \"InventorDoc\": {\n                          \"url\": \"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_FILE>\",\n              \"verb\": \"get\",\n              \"headers\": {\n                  \"Authorization\": \"Bearer <YOUR_ACCESS_TOKEN>\"\n              }\n                  },\n                  \"InventorParams\": {\n                          \"url\": \"data:application/json,{\\\"height\\\":\\\"16 in\\\", \\\"width\\\":\\\"10 in\\\"}\"\n                  },\n                  \"OutputIpt\": {\n                          \"url\": \"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<RESIZED_IPT_FILENAME>\",\n                          \"verb\": \"put\",\n              \"headers\": {\n                  \"Authorization\": \"Bearer <YOUR_ACCESS_TOKEN>\"\n              }\n                  },\n                  \"OutputBmp\": {\n                          \"url\": \"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<GENERATED_BMP_FILENAME>\",\n                          \"verb\": \"put\",\n              \"headers\": {\n                  \"Authorization\": \"Bearer <YOUR_ACCESS_TOKEN>\"\n              }\n          }\n          }\n  }'",
      "parsed": {
        "activityId": "<YOUR_APP_NICKNAME>.ChangeParamActivity+my_current_version",
        "arguments": {
          "InventorDoc": {
            "url": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_FILE>",
            "verb": "get",
            "headers": {
              "Authorization": "Bearer <YOUR_ACCESS_TOKEN>"
            }
          },
          "InventorParams": {
            "url": "data:application/json,{\"height\":\"16 in\", \"width\":\"10 in\"}"
          },
          "OutputIpt": {
            "url": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<RESIZED_IPT_FILENAME>",
            "verb": "put",
            "headers": {
              "Authorization": "Bearer <YOUR_ACCESS_TOKEN>"
            }
          },
          "OutputBmp": {
            "url": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<GENERATED_BMP_FILENAME>",
            "verb": "put",
            "headers": {
              "Authorization": "Bearer <YOUR_ACCESS_TOKEN>"
            }
          }
        }
      }
    },
