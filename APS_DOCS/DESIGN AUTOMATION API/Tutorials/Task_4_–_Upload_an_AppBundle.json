      ],
      "rows": [
        {
          "Attribute": "endpointURL",
          "Description": "This is the URL you must upload your AppBundle zip file to."
        },
        {
          "Attribute": "version",
          "Description": "The version number for the AppBundle created by the POST request. For new AppBundles, the returned version is always 1."
        },
        {
          "Attribute": "formData",
          "Description": "The form data that needs to accompany your AppBundle upload. The formData expires in 3600 seconds."
        }
