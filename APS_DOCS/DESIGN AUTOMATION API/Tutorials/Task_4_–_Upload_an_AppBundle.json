      "headers": [
        "HTTP Request",
        "Description"
      ],
      "rows": [
        {
          "HTTP Request": "POST /appbundles",
          "Description": "Registers a new AppBundle."
        },
        {
          "HTTP Request": "POST /appbundles/{id}/aliases",
          "Description": "Creates a new alias for the AppBundle."
        },
        {
          "HTTP Request": "POST /appbundles/{id}/versions",
          "Description": "Creates a new version of the AppBundle."
        },
        {
          "HTTP Request": "PATCH /appbundles/{id}/aliases/{aliasId}",
          "Description": "Modify alias details."
        }
      ]
    },
