  "title": "Task 5 – Submit a WorkItem",
  "tables": [
    {
      "label": "",
      "headers": [
        "HTTP Request",
        "Description"
      ],
      "rows": [
        {
          "HTTP Request": "POST /workitems",
          "Description": "Creates a new WorkItem and queues it for processing."
        },
        {
          "HTTP Request": "GET /workitems/{id}",
          "Description": "Gets the status of a specific WorkItem."
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Option",
        "OAuth Type",
        "Required Body Content",
        "Notes",
        "Use Case"
      ],
      "rows": [
        {
          "Option": "Submit for your activity on behalf of yourself as Fusion user",
          "OAuth Type": "2LO",
          "Required Body Content": "PAT of Fusion user",
          "Notes": "The owner of the app of the 2LO token must be same as the user that has created the PAT.",
          "Use Case": "Access is needed for a “service user’s” data that is aggregated from customers into one account"
        },
        {
          "Option": "Submit for your activity on behalf of a different Fusion user",
          "OAuth Type": "3LO",
          "Required Body Content": "PAT of Fusion user + Signed Activity ID",
          "Notes": "3LO token must be for the same user as the PAT",
          "Use Case": "Access is needed for direct customer data that logs in and allows it"
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Attribute",
        "Description"
      ],
      "rows": [
        {
          "Attribute": "activityId",
          "Description": "The fully qualified id of the activity (owner.activity+alias) this WorkItem will execute."
        },
        {
          "Attribute": "arguments",
          "Description": "Contains all the parameters that need to be passed to the Activity specified by activityId. They must match the parameters you specified in Task 5, when you created the Activity. In this case we send over the PAT so DA4Fusion can access files on Fusion teams, aswell as “d3”: “40mm” as in a map of parameters to change the height of the nut to 40mm, additonal to the fileURN of the design we want to change."
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Attribute",
        "Description"
      ],
      "rows": [
        {
          "Attribute": "status",
          "Description": "Indicates if execution is pending, successful, failed or cancelled."
        },
        {
          "Attribute": "reportUrl",
          "Description": "The URL to get the report log for this WorkItem’s execution."
        }
      ]
    }
  ],
  "codeExamples": [
    {
      "raw": "curl -X POST \\\n  'https://developer.api.autodesk.com/da/us-east/v3/workitems' \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer <YOUR_ACCESS_TOKEN>' \\\n  -d '{\n          \"activityId\": \"<YOUR_NICKNAME>.ConfigureDesignActivity+my_current_version\", \\\n     \"arguments\": {\n        \"PersonalAccessToken\": \"<YOUR_PERSONAL_ACCESSTOKEN>\",\n        \"TaskParameters\": \"{\\n  \\\"fileURN\\\": \\\"urn:adsk.wipprod:dm.lineage:shuH8zKvThW_4Tdu-m22sw\\\",\\n  \\\"parameters\\\": {\\n    \\\"d3\\\": \\\"40mm\\\"\\n  }\\n}\"\n      }\n  }'"
    },
    {
      "raw": "{\n    \"status\": \"pending\",\n    \"stats\": {\n        \"timeQueued\": \"2023-09-27T08:52:30.7161306Z\"\n    },\n    \"id\": \"<YOUR_WORKITEM_ID>\"\n}",
      "parsed": {
