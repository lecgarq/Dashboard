  "title": "Task 7 – Submit a WorkItem",
  "tables": [
    {
      "label": "",
      "headers": [
        "HTTP Request",
        "Description"
      ],
      "rows": [
        {
          "HTTP Request": "POST /workitems",
          "Description": "Creates a new WorkItem and queues it for processing."
        },
        {
          "HTTP Request": "GET /workitems/{id}",
          "Description": "Gets the status of a specific WorkItem."
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Attribute",
        "Description"
      ],
      "rows": [
        {
          "Attribute": "activityId",
          "Description": "The target Activity defined by “owner.activity+alias”(<YOUR_NICKNAME>.DeleteWallsActivity+test) this WorkItem will execute."
        },
        {
          "Attribute": "arguments",
          "Description": "The argument list that is required by the Activity (DeleteWallsActivity):\n\n- rvtFile - The URN of the input file that the Automation Service must “get” from OSS.\n- result - The URN of the output file that the Automation Service must “put” (upload) to OSS."
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Attribute",
        "Description"
      ],
      "rows": [
        {
          "Attribute": "status",
          "Description": "Indicates if execution is pending, successful, failed or cancelled."
        },
        {
          "Attribute": "reportUrl",
          "Description": "The URL to get the report log for this WorkItem’s execution."
        }
      ]
    }
  ],
  "codeExamples": [
    {
      "raw": "curl -X POST \\\n  'https://developer.api.autodesk.com/da/us-east/v3/workitems' \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer <YOUR_ACCESS_TOKEN>' \\\n  -d '{\n        \"activityId\": \"<YOUR_APP_NICKNAME>.DeleteWallsActivity+test\",\n        \"arguments\": {\n          \"rvtFile\": {\n            \"url\": \"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_FILE>\",\n              \"verb\": \"get\",\n              \"headers\": {\n                  \"Authorization\": \"Bearer <YOUR_ACCESS_TOKEN>\"\n              }\n          },\n          \"result\": {\n            \"url\": \"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<RESULT_FILE_OBJECT_KEY>\",\n                              \"verb\": \"put\",\n              \"headers\": {\n                  \"Authorization\": \"Bearer <YOUR_ACCESS_TOKEN>\"\n              }\n          }\n        }\n      }'",
