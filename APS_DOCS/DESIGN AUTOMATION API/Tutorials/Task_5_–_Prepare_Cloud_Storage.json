  "title": "Task 5 – Prepare Cloud Storage",
  "tables": [
    {
      "label": "",
      "headers": [
        "HTTP Request",
        "Description"
      ],
      "rows": [
        {
          "HTTP Request": "POST /buckets",
          "Description": "Creates an OSS Bucket."
        },
        {
          "HTTP Request": "GET /buckets/{bucketKey}/objects/{objectKey}/signeds3upload",
          "Description": "Requests an S3 signed URL with which to upload an object."
        },
        {
          "HTTP Request": "POST /buckets/{bucketKey}/objects/{objectKey}/signeds3upload",
          "Description": "Instructs OSS to complete the object creation process after the bytes have been uploaded directly to S3."
        },
        {
          "HTTP Request": "POST /buckets/{bucketKey}/objects/{objectKey}/signed",
          "Description": "Creates a signed URL to an object in an OSS bucket."
        }
      ]
    },
    {
      "label": "",
      "headers": [
        "Attribute",
        "Description"
      ],
      "rows": [
        {
          "Attribute": "uploadKey",
          "Description": "An ID to uniquely identify the upload session. You must use this ID in Step 4."
        },
        {
          "Attribute": "urls",
          "Description": "Contains the URL you must use to upload the file to. You must use this URL in Step 3."
        }
      ]
    }
  ],
  "codeExamples": [
    {
      "raw": "curl -X POST \\\n    'https://developer.api.autodesk.com/oss/v2/buckets' \\\n    -H 'Authorization: Bearer <YOUR_ACCESS_TOKEN>' \\\n    -H 'Content-Type: application/json' \\\n    -H 'x-ads-region: US' \\\n        -d '{\n            \"bucketKey\": \"<YOUR_BUCKET_KEY>\",\n            \"access\": \"full\",\n            \"policyKey\": \"transient\"\n        }'",
      "parsed": {
        "bucketKey": "<YOUR_BUCKET_KEY>",
        "access": "full",
        "policyKey": "transient"
      }
    },
    {
      "raw": "{\n    \"bucketKey\": \"<YOUR_BUCKET_KEY>\",\n    \"bucketOwner\": \"<YOUR_APP_CLIENT_ID>\",\n    \"createdDate\": 1695804019627,\n    \"permissions\": [\n        {\n            \"authId\": \"<YOUR_APP_CLIENT_ID>\",\n            \"access\": \"full\"\n        }\n    ],\n    \"policyKey\": \"transient\"\n}",
      "parsed": {
        "bucketKey": "<YOUR_BUCKET_KEY>",
        "bucketOwner": "<YOUR_APP_CLIENT_ID>",
        "createdDate": 1695804019627,
        "permissions": [
          {
            "authId": "<YOUR_APP_CLIENT_ID>",
            "access": "full"
          }
        ],
        "policyKey": "transient"
      }
    },
    {
      "raw": "curl -X GET \\\n    \"https://developer.api.autodesk.com/oss/v2/buckets/<YOUR_BUCKET_KEY>/objects/<OBJECT_KEY_4_INPUT_FILE>/signeds3upload\"\n    -H \"Authorization: Bearer <YOUR_ACCESS_TOKEN>\""
    },
    {
      "raw": "{\n  \"uploadKey\": \"<YOUR_UPLOAD_KEY>\",\n  \"uploadExpiration\": \"2023-09-30T00:00:00Z\",\n  \"urlExpiration\": \"2023-09-27T08:51:57Z\",\n  \"urls\": [\n      \"<SIGNED_UPLOAD_URL>\"\n  ]\n}",
      "parsed": {
        "uploadKey": "<YOUR_UPLOAD_KEY>",
        "uploadExpiration": "2023-09-30T00:00:00Z",
        "urlExpiration": "2023-09-27T08:51:57Z",
        "urls": [
          "<SIGNED_UPLOAD_URL>"
        ]
      }
    },
    {
      "raw": "curl -X PUT \\\n     \"<SIGNED_UPLOAD_URL>\" \\\n     --data-binary '@<PATH_TO_FILE_TO_UPLOAD>/box.ipt'"
    },
    {
      "raw": "curl -X POST \\\n     \"https://developer.api.autodesk.com/oss/v2/buckets/<YOUR_BUCKET_KEY>/objects/<OBJECT_KEY_4_INPUT_FILE>/signeds3upload\" \\\n      -H \"Authorization: Bearer <YOUR_ACCESS_TOKEN>\" \\\n      -d '{\n            \"uploadKey\": \"<YOUR_UPLOAD_KEY>\"\n        }'",
      "parsed": {
        "uploadKey": "<YOUR_UPLOAD_KEY>"
      }
    },
    {
      "raw": "{\n    \"bucketKey\": \"<YOUR_BUCKET_KEY>\",\n    \"objectId\": \"urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_FILE>\",\n    \"objectKey\": \"<OBJECT_KEY_4_INPUT_FILE>\",\n    \"size\": 134656,\n    \"contentType\": \"application/octet-stream\",\n    \"location\": \"https://developer.api.autodesk.com/oss/v2/buckets/<YOUR_BUCKET_KEY>/objects/<YOUR_OBJECT_KEY>\"\n}",
      "parsed": {
        "bucketKey": "<YOUR_BUCKET_KEY>",
        "objectId": "urn:adsk.objects:os.object:<YOUR_BUCKET_KEY>/<OBJECT_KEY_4_INPUT_FILE>",
        "objectKey": "<OBJECT_KEY_4_INPUT_FILE>",
        "size": 134656,
        "contentType": "application/octet-stream",
        "location": "https://developer.api.autodesk.com/oss/v2/buckets/<YOUR_BUCKET_KEY>/objects/<YOUR_OBJECT_KEY>"
      }
    }
