      "raw": "{\n        \"TaskScriptUrl\":{\n                \"url\":\"https://<YOUR_SERVER_URL>/script/sample.ts\",\n                \"headers\":{\n                        \"Authorization\":\"Bearer <YOUR_ACCESS_TOKEN>\"\n                }\n        }\n}",
