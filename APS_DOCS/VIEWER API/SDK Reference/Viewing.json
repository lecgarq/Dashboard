    {
      "label": "",
      "headers": [],
      "rows": [
        {
          "col_0": "viewCubeboolean",
          "col_1": "Default Value: true. Sets the visibility of the viewcube. Set to false for mobile devices."
        },
        {
          "col_0": "alwaysUsePivotboolean",
          "col_1": "Default Value: false. Orbit controls always orbit around the currently set pivot point."
        },
        {
          "col_0": "zoomTowardsPivotboolean",
          "col_1": "Default Value: false. default direction for camera dolly (zoom) operations to be towards the camera pivot point."
        },
        {
          "col_0": "reverseHorizontalLookDirectionboolean",
          "col_1": "Default Value: false. Sets a view navigation option to reverse the default direction for horizontal look operations."
        },
        {
          "col_0": "reverseVerticalLookDirectionboolean",
          "col_1": "Default Value: false. Sets a view navigation option to reverse the default direction for vertical look operations."
        },
        {
          "col_0": "orbitPastWorldPolesboolean",
          "col_1": "Default Value: true. Set a view navigation option to allow the orbit controls to move the camera beyond the north and south poles (world up/down direction)."
        },
        {
          "col_0": "clickToSetCOIboolean",
          "col_1": "Default Value: false. Modify the default click behavior for the viewer."
        },
        {
          "col_0": "ghostingboolean",
          "col_1": "Default Value: true. Toggles ghosting during search and isolate."
        },
        {
          "col_0": "optimizeNavigationboolean",
          "col_1": "Default Value: false. Toggles whether the navigation should be optimized for performance. Set to true for mobile devices."
        },
        {
          "col_0": "ambientShadowsboolean",
          "col_1": "Default Value: true. Enables or disables ambient shadows."
        },
        {
          "col_0": "antialiasingboolean",
          "col_1": "Default Value: true. Enables or disables antialiasing. Set to false for mobile devices."
        },
        {
          "col_0": "groundShadowboolean",
          "col_1": "Default Value: true. Toggles ground shadow."
        },
        {
          "col_0": "groundReflectionboolean",
          "col_1": "Default Value: false. Toggles ground reflection."
        },
        {
          "col_0": "lineRenderingboolean",
          "col_1": "Default Value: true. Hides all lines in the scene."
        },
        {
          "col_0": "edgeRenderingboolean",
          "col_1": "Default Value: false. Turns edge topology display on/off (where available)."
        },
        {
          "col_0": "lightPresetnumber",
          "col_1": "Default Value: 1. Sets the Light Presets (Environments) for the Viewer."
        },
        {
          "col_0": "envMapBackgroundboolean",
          "col_1": "Default Value: false. Toggles environment map for background."
        },
        {
          "col_0": "bimWalkToolPopupboolean",
          "col_1": "Default Value: true. Toggles the bimwalk tool popup."
        },
        {
          "col_0": "grayscaleboolean",
          "col_1": "Default Value: false. Overrides line colors in 2D models to render in shades of gray."
        },
        {
          "col_0": "swapBlackAndWhiteboolean",
          "col_1": "Default Value: false. Will switch to white lines on a black background for 2D models."
        },
        {
          "col_0": "progressiveRenderingboolean",
          "col_1": "Default Value: true. Toggles whether progressive rendering is used."
        },
        {
          "col_0": "openPropertiesOnSelectboolean",
          "col_1": "Default Value: false. Open property panel when selecting an object (Only for GuiViewer3D)."
        },
        {
          "col_0": "pointRenderingboolean",
          "col_1": "Default Value: true. Hides all points in the scene."
        },
        {
          "col_0": "backgroundColorPreset",
          "col_1": "Default Value: null. Sets a color to the background."
        },
        {
          "col_0": "reverseMouseZoomDirboolean",
          "col_1": "Default Value: false. Reverse the default direction for camera dolly (zoom) operations."
        },
        {
          "col_0": "leftHandedMouseSetupboolean",
          "col_1": "Default Value: false. Reverse mouse buttons from their default assignment (i.e. Left mouse operation becomes right mouse and vice versa)."
        },
        {
          "col_0": "fusionOrbitboolean",
          "col_1": "Default Value: true. Sets the orbit to fusion orbit."
        },
        {
          "col_0": "fusionOrbitConstrainedboolean",
          "col_1": "Default Value: true. Sets the the orbit to the contrained fusion orbit."
        },
        {
          "col_0": "wheelSetsPivotboolean",
          "col_1": "Default Value: false. Sets wheel-zoom action to automatically reset the orbit pivot to the location under the cursor."
        },
        {
          "col_0": "selectionSetsPivotboolean",
          "col_1": "Default Value: false. Sets selection / un-selection action to automatically reset the orbit pivot to be the center of the multiple selection."
        },
        {
          "col_0": "bimWalkNavigatorTypestring",
          "col_1": "Default Value: ‘default’. Sets the BimWalk tool navigator."
        },
        {
          "col_0": "defaultNavigationTool3Dstring",
          "col_1": "Default Value: ‘default’. Sets which navigation tool will be used by the viewer. (ie: ‘extractor_defined’ || ‘bimwalk’)"
        },
        {
          "col_0": "loadingAnimationboolean",
          "col_1": "Default Value: true. Toggles loading animation for 2D Models."
        },
        {
          "col_0": "zoomDragSpeednumber",
          "col_1": "Default value: 100. Sets a sensitivity of mouse movement with the zoom tool."
        },
        {
          "col_0": "zoomScrollSpeednumber",
          "col_1": "Default value: 0.6. Sets a sensitivity of the mouse scroll wheel when zooming."
        }
      ]
    },
