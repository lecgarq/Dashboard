    {
      "raw": "// Viewer element display name field\n{\"key\":\"p153cb174\",\"category\":\"__name__\",\"type\":\"String\",\"name\":\"name\",\"uom\":null}\n// Revit category name field\n{\"key\":\"p20d8441e\",\"category\":\"__category__\",\"type\":\"String\",\"name\":\"_RC\",\"uom\":null}\n// Revit family name field\n{\"key\":\"p30db51f9\",\"category\":\"__category__\",\"type\":\"String\",\"name\":\"_RFN\",\"uom\":null}\n// Revit type name field\n{\"key\":\"p13b6b3a0\",\"category\":\"__category__\",\"type\":\"String\",\"name\":\"_RFT\",\"uom\":null}"
    },
    {
      "raw": "{\n    \"query\": {\n        \"$and\": [\n            { \"$notnull\": \"s.props.p20d8441e\" },\n            { \"$notnull\": \"s.props.p30db51f9\" },\n            { \"$notnull\": \"s.props.p13b6b3a0\" },\n            { \"$gt\": [{ \"$count\": \"s.views\" }, 0] }\n        ]\n    },\n    \"columns\": {\n        \"s.svf2Id\": true,\n        \"lmvName\": \"s.props.p153cb174\",\n        \"revitCategory\": \"s.props.p20d8441e\",\n        \"revitFamily\": \"s.props.p30db51f9\",\n        \"revitType\": \"s.props.p13b6b3a0\",\n        \"s.views\": true\n    }\n}",
      "parsed": {
        "query": {
          "$and": [
            {
              "$notnull": "s.props.p20d8441e"
            },
            {
              "$notnull": "s.props.p30db51f9"
            },
            {
              "$notnull": "s.props.p13b6b3a0"
            },
            {
              "$gt": [
                {
                  "$count": "s.views"
                },
                0
              ]
            }
          ]
        },
        "columns": {
          "s.svf2Id": true,
          "lmvName": "s.props.p153cb174",
          "revitCategory": "s.props.p20d8441e",
          "revitFamily": "s.props.p30db51f9",
          "revitType": "s.props.p13b6b3a0",
          "s.views": true
        }
      }
    },
    {
      "raw": "select\n    s.svf2Id,\n    s.props.p153cb174 as lmvName,\n    s.props.p20d8441e as revitCategory,\n    s.props.p30db51f9 as revitFamily,\n    s.props.p13b6b3a0 as revitType,\n    s.views\nfrom S3Object[*] s\nwhere\n    s.props.p20d8441e is not null and\n    s.props.p30db51f9 is not null and\n    s.props.p13b6b3a0 is not null and\n    count(s.views) > 0"
    },
    {
      "raw": "{\"key\":\"p6637df3c\",\"category\":\"Materials and Finishes\",\"type\":\"String\",\"name\":\"Structural Material\",\"uom\":null}\n{\"key\":\"p69a0daab\",\"category\":\"Dimensions\",\"type\":\"Double\",\"name\":\"Ht\",\"uom\":\"ft\"}"
    },
    {
      "raw": "{\n    \"query\":\n    {\n        \"$and\": [\n            {\n                \"$or\": [\n                    { \"$like\": [\"s.props.p6637df3c\", \"'%Steel%'\"] },\n                    { \"$like\": [\"s.props.p6637df3c\", \"'%steel%'\"] }\n                ]\n            },\n            {\n                \"$ge\": [\"s.props.p69a0daab\", 0.5]\n            }\n        ]\n    }\n}",
      "parsed": {
        "query": {
          "$and": [
            {
              "$or": [
                {
                  "$like": [
                    "s.props.p6637df3c",
                    "'%Steel%'"
                  ]
                },
                {
                  "$like": [
                    "s.props.p6637df3c",
                    "'%steel%'"
                  ]
                }
              ]
            },
            {
              "$ge": [
                "s.props.p69a0daab",
                0.5
              ]
            }
          ]
        }
      }
    },
    {
      "raw": "select s.*\nfrom S3Object[*] s\nwhere\n    s.props.p69a0daab >= 0.5 and\n    (s.props.p6637df3c like '%Steel%' or s.props.p6637df3c like '%steel%')"
    }
