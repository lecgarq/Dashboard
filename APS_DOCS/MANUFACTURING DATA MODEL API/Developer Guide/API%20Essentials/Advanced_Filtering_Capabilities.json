      "rows": [
        {
          "Filter type": "Property exists",
          "Query": "“elementFilter”: {\n“query”: “property.name==Perimeter”\n}",
          "Expectation": "Returns elements those have “Perimeter” property (case-sensitive)."
        },
        {},
        {
          "Filter type": "By name and value",
          "Query": "“elementFilter”: {\n“query”: “property.name.category==Walls”\n}",
          "Expectation": "Returns elements those have property “category”.\nthat has value “Walls” (case-sensitive)"
        },
        {},
        {
          "Filter type": "By multiple values",
          "Query": "“elementFilter”: {\n“query”: “‘property.name.Family Name’==’Rectangular Mullion’ or\n‘property.name.Family Name’==Window-Fixed”\n}",
          "Expectation": "Returns elements with property “Family Name” having values “Rectangular Mullion” or “Window-Fixed”.\n(All value comparisons are case-sensitive)"
        },
        {},
        {},
        {
          "Filter type": "By metadata (elements)",
          "Query": "“elementFilter”: {\n“query”: “metadata.id=in=(‘ID_1’, ‘ID_2’)”\n}",
          "Expectation": "Returns elements with id either “ID_1” or “ID_2” or both.\n(This filter is incompatible with the combination of other filters)"
        },
        {},
        {
          "Filter type": "By  metadata (elements)",
          "Query": "“elementFilter”: {\n“query”: “metadata.name==’HVAC Feed’”\n}",
          "Expectation": "Returns elements with name “HVAC Feed”."
        },
        {},
        {
          "Filter type": "By metadata (exchange)",
          "Query": "“exchangeFilterInput” : {\n“query”: “version.fromId==’latest-1’ and version.toId==’latest’”\n}",
          "Expectation": "Returns exchange and its elements in the provided range, for example, latest-1 to latest.\n(Only latest-1 to latest is supported currently.)"
        },
        {},
        {
          "Filter type": "By range",
          "Query": "“elementFilter”: {\n“query”: “property.name.area >= 100.0 and property.name.area < 200.0”\n}",
          "Expectation": "Returns elements with property area in the provided range."
        },
