# -----------------------------------------------------------------------------
# BIM DASHBOARD - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in the values.
# -----------------------------------------------------------------------------

# NextAuth Configuration
# Use a strong random string for secrets in production.
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true
BETTER_AUTH_SECRET=

# Database Configuration
DATABASE_URL=
DIRECT_URL=

# Admin promotion logic
ADMIN_EMAIL=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_ID=

# APS (Autodesk Platform Services)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:3000/api/auth/callback/autodesk
APS_SCOPES=data:read viewables:read user:read account:read
APS_PROJECT-ID=
APS_HUB_ID=

# UploadThing
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Resend (for password reset emails)
RESEND_API_KEY=
RESEND_EMAIL=
RESEND_ID=

# Redis / Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Phase: Access Analysis Redesign (2026-05-13). Set to "1" to render the new
# unified Access Analysis tab at /users. Falls through to legacy UsersDirectoryClient
# when unset.
NEXT_PUBLIC_NEW_ACCESS_ANALYSIS=

# Access Analysis 2D graph engine (2026-05-28). The 2D graph runs cosmos.gl's GPU
# cluster-anchor force simulation so it animates in real time from the sliders,
# independent of the 3D engine. ON by default; set to "0" to revert to the legacy
# frozen + B.2-preview path. (Automatically disabled under the e2e test bridge.)
NEXT_PUBLIC_ACC_GPU_2D=1

# =============================================================================
# DB & Config Hardening (DB-03) — per 09-CONTEXT.md / CONCERNS §1.4/§1.5
# =============================================================================

# PG_POOL_MAX — per DB-03 — sized for access-analysis at scale.
# Formula: pool × web-workers must stay <= the local Postgres max_connections ceiling.
# Default would be 5 (production) / 10 (development). 32 matches the verified
# working value from the access-analysis OOM investigation (2026-06).
PG_POOL_MAX=32

# NODE_OPTIONS — per DB-03 — --max-old-space-size=8192 (8 GB heap) required to
# avoid OOM during the AccFolderPermission / bulkUsers loads at hub scale.
# Without this, the ~5M-row AccFolderPermission aggregate (pre-fix) or large
# access-analysis builds can exhaust the default V8 heap (~512 MB).
NODE_OPTIONS=--max-old-space-size=8192

# PROJ-02: deliberate escape hatch for the hard-guarded includePermissionContexts raw scan.
# Leave UNSET in normal operation. Set to 1 ONLY to re-enable the ~6M-row AccFolderPermission
# scan for the WS2 edge-feed / per-folder-ACL path (re-opens the OOM window TEST-01 guards).
ACC_ALLOW_RAW_PERMISSION_SCAN=
