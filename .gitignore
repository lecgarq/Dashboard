# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — covers .next plus every isolated-dist variant the deploy/UAT/e2e
# flows create (.next-old, .next-uat-*, .next-e2e-*, .next-prev-deploy, backups…);
# zero tracked files start with .next, so the glob is safe.
/.next*/
/out/

# playwright e2e
/playwright/.auth/
/playwright-report/
/test-results/

# production
/build

# misc
.DS_Store
*.pem
/.local/
/.vscode/
/.claude/settings.local.json
/.claude/*.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.err.log
*.out.log
/logs/
log-console.txt
yjs-logs*.txt

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials - service account JSON files
gen-lang-client-*.json

# local secrets file — NEVER commit this
JSOON.JSON
*.secrets.json
texti.env

# temp / dump files
/tmp/
/.tmp/
/prisma/dev.db
.tmp-*.txt
/400
/.cleanup-quarantine/
/scratch/
/scripts/_rollback/
/.playwright-mcp/
*.py[cod]
__pycache__/
/*.png
/*.jpg
/*.gif
/*.mov
/PROBLEM*.png
/Screenshot*.png
/acc.xlsx
/Start-MTY-Monitor.bat
/Start-Monitor.cmd
/watch-partials-progress.bat
/watch-partials-ui.bat

# self-hosted DuckDB-Wasm assets (copied by scripts/copy-duckdb-wasm.cjs in postinstall)
/public/duckdb-wasm/

# Brainstorming visual companion (local mockups)
.superpowers/

# Embedding build artifacts
.embedding/
scripts/_attic/

# Local UI inspection screenshots (scripts/ui-inspect.ts, ui-prove-activity.ts)
.ui-shots/
# Before/after capture runs — PR evidence, attached to the review, never committed.
/screenshots/

# Repo architecture map outputs: keep policy/docs, ignore generated snapshots.
.tools/repo-map/*
!.tools/repo-map/baselines/
!.tools/repo-map/baselines/**
!.tools/repo-map/AI-ANALYSIS-PROMPT.md
!.tools/repo-map/architecture-summary.md
.impeccable/*
!.impeccable/config.json
