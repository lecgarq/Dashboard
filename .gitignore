# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# playwright e2e
/playwright/.auth/
/playwright-report/
/test-results/

# production
/build

# misc
.DS_Store
*.pem
/.local/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.err.log
*.out.log
/logs/
log-console.txt
yjs-logs*.txt

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials - service account JSON files
gen-lang-client-*.json

# local secrets file — NEVER commit this
JSOON.JSON
*.secrets.json
texti.env

# temp / dump files
/tmp/
/prisma/dev.db
.tmp-*.txt
/400
/.cleanup-quarantine/
/scratch/
/scripts/_rollback/
/.playwright-mcp/
*.py[cod]
__pycache__/
/*.png
/PROBLEM*.png
/Screenshot*.png

# self-hosted DuckDB-Wasm assets (copied by scripts/copy-duckdb-wasm.cjs in postinstall)
/public/duckdb-wasm/
