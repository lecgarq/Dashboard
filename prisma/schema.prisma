generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/erd.md"
}


datasource db {
  provider = "postgresql"
}

// ============ AUTH MODELS ============

model User {
  id             String             @id @default(cuid())
  name           String?
  email          String             @unique
  username       String?            @unique
  emailVerified  DateTime?
  password       String?
  image          String?
  department     String?
  jobTitle       String?
  role           String             @default("VIEWER")
  accounts       Account[]
  sessions       Session[]
  tasks          UserTask[]
  moduleAccess   UserModuleAccess[]
  pendingRequest PendingRequest?
  createdAt      DateTime           @default(now())
  lastLoginAt    DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApprovedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PendingRequest {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String   @unique
  name        String?
  provider    String
  requestedAt DateTime @default(now())
  status      String   @default("PENDING")
}

model UserModuleAccess {
  id     String @id @default(cuid())
  userId String
  module String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

// ============ MULTI-PROJECT MODELS ============

model Project {
  id           String      @id @default(cuid())
  name         String
  client       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  families     Family[]
  userTasks    UserTask[]
  clashWiki    ClashWiki[]
  clashTasks   ClashTask[]
  simWiki      SimWiki[]
  simTasks     SimTask[]
  apsProjectId String?
  apsHubId     String?
}

// ============ MODULE 1: FAMILIAS PARAMÉTRICAS ============
// phase values: TODO | IN_PROGRESS | REVIEW | DONE

model Family {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  category       String              @default("Generic Models")
  phase          String              @default("TODO")
  phaseOrder     Int                 @default(0)
  description    String?
  nextSteps      String?
  dueDate        DateTime?
  requestDate    DateTime?
  completionDate DateTime?
  owner          String?
  isBlocked      Boolean             @default(false)
  blockedBy      String?
  changelog      FamilyChangelog[]
  attachments    FamilyAttachment[]
  deliverables   FamilyDeliverable[]
  apsUrn         String?
  apsStatus      String?             @default("NONE") // NONE | PROCESSING | SUCCESS | FAILED
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([phase])
  @@index([dueDate])
  @@index([updatedAt])
}

model FamilyChangelog {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  version   String
  author    String
  message   String
  impact    String?
  createdAt DateTime @default(now())
}

model FamilyAttachment {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  type     String // IMAGE | VIDEO | FILE
  url      String
  name     String
}

model FamilyDeliverable {
  id       String  @id @default(cuid())
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name     String
  fileUrl  String?
  done     Boolean @default(false)
}

// ============ MODULE 2: CLASH DETECTION ============
// status values: DRAFT | REVIEW | APPROVED
// task status values: PLANNING | IN_PROGRESS | REVIEW | DONE

model ClashWiki {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   String   @unique
  title     String
  content   String
  yjsState  Bytes?
  status    String   @default("DRAFT")
  order     Int
  updatedAt DateTime @updatedAt
}

model ClashTask {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("PLANNING")
  milestone   String?
  dueDate     DateTime?
  owner       String?
  order       Int       @default(0)
  isBlocked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([updatedAt])
}

model ClashToolRelease {
  id          String   @id @default(cuid())
  version     String
  changelog   String
  downloadUrl String?
  releasedAt  DateTime @default(now())
  testCases   String?
}

// ============ MODULE: SIM AUTOMATION ============
// Cloned from Clash Detection

model SimWiki {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   String   @unique
  title     String
  content   String
  yjsState  Bytes?
  status    String   @default("DRAFT")
  order     Int
  updatedAt DateTime @updatedAt
}

model SimTask {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("PLANNING")
  milestone   String?
  dueDate     DateTime?
  owner       String?
  order       Int       @default(0)
  isBlocked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
}

model SimToolRelease {
  id          String   @id @default(cuid())
  version     String
  changelog   String
  downloadUrl String?
  releasedAt  DateTime @default(now())
  testCases   String?
}

// ============ MODULE 3: EXAMEN REVIT ============

model RevitExam {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      String          @default("PLANNING")
  formUrl     String?
  formId      String?
  dueDate     DateTime?
  tasks       ExamBuildTask[]
  results     ExamResult[]
  createdAt   DateTime        @default(now())
}

model ExamBuildTask {
  id      String    @id @default(cuid())
  examId  String
  exam    RevitExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  title   String
  status  String    @default("PLANNING")
  order   Int       @default(0)
  dueDate DateTime?
}

model ExamResult {
  id             String    @id @default(cuid())
  examId         String
  exam           RevitExam @relation(fields: [examId], references: [id])
  candidateName  String
  candidateEmail String?
  score          Float
  maxScore       Float
  attempts       Int       @default(1)
  completedAt    DateTime  @default(now())
  notes          String?
  failureTopics  String?
}

// ============ TASK / TO-DO SYSTEM ============
// status values: TODO | IN_PROGRESS | DONE
// priority values: LOW | MEDIUM | HIGH | URGENT

model UserTask {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String           @default("TODO")
  priority    String           @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments TaskAttachment[]
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      UserTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url       String
  name      String
  type      String // IMAGE | PDF
  createdAt DateTime @default(now())
}

// ============ MODULE: LOD CHECKER ============

model LodFamily {
  id                 String   @id @default(cuid())
  nameOfFile         String   @unique
  familyName         String?
  finalCategory      String?
  lodLabel           String?
  provider           String?
  caption            String?
  fullDescription    String?
  confidenceLevel    String?
  fileSizeKb         Float?
  possibleCategories String[] @default([])
  originalFile       String?
  imagePath          String?
  thumbPath          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  embedding LodEmbedding?
  graphNode LodGraphNode?

  @@index([finalCategory])
  @@index([lodLabel])
  @@index([provider])
  @@index([familyName])
}

model LodEmbedding {
  id       String                      @id @default(cuid())
  familyId String                      @unique
  family   LodFamily                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  vector   Float[]
  pgvector Unsupported("vector(768)")? // managed by raw SQL migration 20260416011500_fix_lod_search_foundation; HNSW index 20260416182000

  @@index([familyId])
}

model LodGraphNode {
  id        String    @id @default(cuid())
  familyId  String    @unique
  family    LodFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  neighbors Int[]     @default([])

  @@index([familyId])
}

model LodCategory {
  id            String  @id @default(cuid())
  name          String  @unique
  group         String?
  description   String?
  subcategories Json?

  @@index([group])
}

// ============ MODULE: ACC MEMBER CACHE ============

model AccMemberCache {
  id        String   @id @default(cuid())
  email     String   @unique
  data      Json
  syncedAt  DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([syncedAt])
}

// ============ MODULE: ACC HUB ROLE CACHE ============

model AccHubRoleCache {
  id       String   @id @default("singleton")
  roles    Json // AccHubRole[]
  syncedAt DateTime @updatedAt
}

// ============ MODULE: ACC GRAPH LAYOUT CACHE ============

model AccGraphLayoutCache {
  id            String   @id @default("singleton")
  nodes         Json
  edges         Json
  positions     Float[]
  dataHash      String
  nodeCount     Int
  edgeCount     Int      @default(0)
  instanceCount Int      @default(0)
  projectCount  Int      @default(0)
  nodeIds       String[] @default([])
  updatedAt     DateTime @updatedAt
}

model AccPersonGraphSnapshot {
  k           Int      @id          // cluster count this snapshot was built for
  dataHash    String
  personCount Int
  edgeCount   Int
  dim         Int
  nodes       Json                  // LayoutNode[] (2D packed)
  nodes3d     Json     @default("[]") // LayoutNode3D[] (static projector positions)
  edges       Json                  // TieredEdge[]
  clusters    Json                  // ClusterMeta[]
  builtAt     DateTime @updatedAt
}

// ============ MODULE: ACC V2.0 RELATIONAL LAYER ============

model AccProject {
  id                String             @id // APS project ID (no b. prefix — Construction Admin)
  accountId         String
  name              String
  jobNumber         String?
  type              String?
  status            String             @default("active") // active | inactive
  folderCrawlStatus String             @default("never") // never | ok | partial | failed
  createdAt         DateTime?
  updatedAt         DateTime           @updatedAt
  members           AccProjectMember[]
  roles             AccProjectRole[]
  folders           AccFolder[]

  @@index([accountId])
  @@index([status])
}

model AccProjectMember {
  id           String           @id @default(cuid())
  projectId    String
  project      AccProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  autodeskId   String
  email        String
  name         String
  status       String // active | pending | deleted
  companyName  String?
  phone        String?
  addedOn      DateTime?
  lastSignIn   DateTime?
  projectAdmin Boolean          @default(false)
  executive    Boolean          @default(false)
  products     Json // per-module tier map
  syncedAt     DateTime
  roles        AccProjectRole[]

  @@unique([projectId, autodeskId])
  @@index([email])
  @@index([projectId])
  @@index([autodeskId])
}

model AccRole {
  id           String           @id // APS role ID
  accountId    String
  name         String
  memberCount  Int              @default(0)
  syncedAt     DateTime
  projectRoles AccProjectRole[]

  @@index([accountId])
}

model AccProjectRole {
  id                      String            @id @default(cuid())
  projectId               String
  project                 AccProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleId                  String
  role                    AccRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  memberId                String?
  member                  AccProjectMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  docsAccessLevel         String?
  projectAdminAccessLevel String?

  @@unique([projectId, roleId, memberId])
  @@index([projectId])
  @@index([roleId])
}

model AccFolder {
  id          String                @id // folder URN (with b. prefix — Data Management)
  projectId   String
  project     AccProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  name        String
  fullPath    String?
  syncedAt    DateTime
  permissions AccFolderPermission[]

  // Slice D — per-folder file rollup (files DIRECTLY in this folder, from tip versions).
  // Nullable: populated when the folder's contents are crawled; null until then.
  fileCount            Int?
  totalSizeBytes       Float? // sum of tip-version storageSize (Float avoids BigInt JS friction)
  lastModifiedTime     DateTime?
  lastModifiedBy       String?
  latestVersionAddedBy String?
  maxVersionNumber     Int?

  @@index([projectId])
  @@index([parentId])
}

model AccFolderPermission {
  id       String    @id @default(cuid())
  folderId String
  folder   AccFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  roleId   String
  actions  String[] // raw APS actions array
  permType String // View Only | View+Download | Upload Only | etc.
  syncedAt DateTime

  @@unique([folderId, roleId])
  @@index([folderId])
}

model AccActivity {
  id         String   @id @default(cuid())
  autodeskId String
  userEmail  String? // resolved from users.csv join at ingest; stored lowercased for case-insensitive lookups
  projectId  String? // empty-string sentinel for admin rows so @@unique dedup works (Postgres NULL != NULL)
  rawAction  String // lossless raw action_type from CSV; normalization happens at query time via lib/acc/activityCategories.ts
  service    String?
  tool       String?
  details    String?
  sourceFile  String   @default("project") // "project" | "admin" — distinguishes project_activities.csv from admin_activities.csv
  ingestRunId String? // FK-like to AccDcIngestRun.id; nullable because rows written before 2026-05-18 schema fix pre-date this column
  createdAt   DateTime

  @@unique([autodeskId, rawAction, createdAt, projectId]) // dedup key for createMany({ skipDuplicates: true }) — intentionally run-agnostic
  @@index([autodeskId, createdAt(sort: Desc)])
  @@index([userEmail, createdAt(sort: Desc)]) // drives ACTV-03 lazy per-user file activity query
  @@index([projectId, createdAt(sort: Desc)])
  @@index([rawAction])
  @@index([ingestRunId]) // forensic lookup: "which run inserted these rows?"
}

model UnresolvedAttribution {
  id         String   @id @default(cuid())
  activityId String // logical FK to AccActivity.id (not enforced — soft retention)
  rawEmail   String? // parsed from details column
  rawDetails String? // full details for forensics
  reason     String // "no_email_match" | "no_autodesk_id_match" | "ambiguous_match"
  createdAt  DateTime @default(now())

  @@index([reason])
  @@index([createdAt])
}

model AccDataConnectorJob {
  id            String    @id @default(cuid())
  requestId     String    @unique // APS Data Connector requestId
  status        String    @default("pending") // pending | running | success | failed
  serviceGroups String[]
  dateRange     String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  downloadUrl   String?
  errorMessage  String?

  @@index([status])
  @@index([startedAt])
}

model SyncMeta {
  id         String    @id // "quick" | "deep"
  lastRunAt  DateTime?
  lastStatus String? // success | failed | skipped
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

// ============ ACC DATA CONNECTOR SNAPSHOT (Phase 8) ============
// Parallel snapshot tables hydrated by daily DC ingest. No FKs (orphans tolerated
// per CONTEXT decision). DC wins on conflict with live-API tables (AccProjectMember).

model AccDcUser {
  id          String    @id
  email       String?
  name        String?
  status      String?
  companyId   String?
  autodeskId  String?
  lastSignIn  DateTime?
  ingestRunId String
  ingestedAt  DateTime

  @@index([email])
  @@index([companyId])
}

model AccDcCompany {
  id          String   @id
  name        String
  hubId       String?
  ingestRunId String
  ingestedAt  DateTime
}

model AccDcProject {
  id          String    @id
  accountId   String
  name        String
  jobNumber   String?
  status      String?
  type        String?
  createdAt   DateTime? // floor for progressive backfill
  ingestRunId String
  ingestedAt  DateTime

  @@index([accountId])
}

model AccDcAccount {
  id          String   @id
  name        String
  region      String?
  ingestRunId String
  ingestedAt  DateTime
}

model AccDcBusinessUnit {
  id          String   @id
  name        String
  accountId   String?
  ingestRunId String
  ingestedAt  DateTime
}

model AccDcRole {
  id          String   @id
  name        String
  accountId   String?
  ingestRunId String
  ingestedAt  DateTime
}

model AccDcProjectUser {
  projectId   String
  userId      String
  status      String?
  addedOn     DateTime?
  lastSignIn  DateTime?
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, userId])
  @@index([userId])
}

model AccDcProjectUserRole {
  projectId   String
  userId      String
  roleId      String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, userId, roleId])
}

model AccDcProjectUserProduct {
  projectId   String
  userId      String
  productKey  String
  accessLevel String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, userId, productKey])
}

model AccDcProjectUserCompany {
  projectId   String
  userId      String
  companyId   String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, userId, companyId])
}

model AccDcProjectUserService {
  projectId   String
  userId      String
  serviceKey  String
  accessLevel String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, userId, serviceKey])
}

model AccDcProjectRole {
  projectId   String
  roleId      String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, roleId])
}

model AccDcProjectProduct {
  projectId   String
  productKey  String
  accessLevel String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, productKey])
}

model AccDcProjectCompany {
  projectId   String
  companyId   String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, companyId])
}

model AccDcProjectService {
  projectId   String
  serviceKey  String
  accessLevel String
  ingestRunId String
  ingestedAt  DateTime

  @@id([projectId, serviceKey])
}

model AccDcAccountService {
  accountId   String
  serviceKey  String
  accessLevel String
  ingestRunId String
  ingestedAt  DateTime

  @@id([accountId, serviceKey])
}

model AccDcIngestRun {
  id                 String    @id @default(cuid())
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  status             String
  sliceWindowStart   DateTime?
  sliceWindowEnd     DateTime?
  projectsProcessed  Int       @default(0)
  rowsByModule       Json
  rowsByAdminCsv     Json
  quotaUsed          Int       @default(0)
  diffSummary        Json?
  unknownModulesSeen String[]  @default([])
  errorMessage       String?

  @@index([startedAt(sort: Desc)])
  @@index([status])
}

model AccDcBackfillProgress {
  projectId        String    @id
  earliestCovered  DateTime?
  latestCovered    DateTime?
  projectCreatedAt DateTime
  newProjectFlag   Boolean   @default(false)
  updatedAt        DateTime  @updatedAt
}

model AccIssue {
  id             String   @id // ACC issue UUID
  projectId      String // ACC Construction-Admin project GUID (loose; logical join AccProject.id)
  displayId      Int?
  title          String
  description    String?
  status         String?
  issueTypeId    String?
  issueSubtypeId String?
  createdBy      String?
  createdAt      DateTime?
  deleted        Boolean  @default(false)

  isCoordination     Boolean @default(false)
  coordinationSource String? // "title" | "description" | "clash-endpoint"
  confidence         String? // "high" | "medium" | "low"
  clashId            String?
  clashValidated     Boolean @default(false)
  projectMcEnabled   Boolean @default(false)

  rawJson    Json?
  fetchRunId String?
  fetchedAt  DateTime @default(now())

  @@index([projectId])
  @@index([isCoordination])
  @@index([clashId])
  @@index([fetchRunId])
  @@index([projectId, isCoordination])
}

model AccIssueFetchRun {
  id                String    @id @default(cuid())
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  projectsTotal     Int?
  projectsOk        Int?
  projectsForbidden Int?
  issuesUpserted    Int?
  coordinationCount Int?
  status            String    @default("running") // running | done | failed
}

// ============ MODULE: ACC INSTANCE EMBEDDING ============
// Precomputed 2D similarity-embedding coordinates + neighbours per graph node.
// Table is created via prisma/migrations-raw/2026-06-08-acc-instance-embedding.sql
// (raw SQL, not prisma migrate) so that pgvector / migrate-choke is avoided.

model AccInstanceEmbedding {
  nodeId         String   @id
  x              Float    @db.Real
  y              Float    @db.Real
  neighbors      Json     @default("[]")
  embeddingRunId String
  updatedAt      DateTime @default(now()) @updatedAt
}

