{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --exclude \"**/tests/e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev": "python scripts/run_dev_stack.py",
    "dev:next": "node scripts/patch-env.js && next dev --webpack -H 0.0.0.0 --port 3000",
    "dev:restart": "node scripts/patch-env.js && python scripts/run_dev_stack.py --port 3000",
    "desktop": "electron electron/main.cjs",
    "tunnel": "node scripts/run-tunnel.js",
    "preview": "python scripts/run_dev_stack.py --mode public --port 3000",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 --port 3000",
    "db:start": "node scripts/postgres-local.js start",
    "db:stop": "node scripts/postgres-local.js stop",
    "db:status": "node scripts/postgres-local.js status",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "lod:engine": "python services/lod-engine/server.py",
    "db:studio": "prisma studio",
    "lint": "eslint",
    "yjs:server": "node scripts/yjs-server.mjs",
    "start:prod": "node scripts/start-router.cjs",
    "knip": "knip",
    "repo-map": "node scripts/repo-map/generate.cjs",
    "repo-map:check": "npm run repo-map && node scripts/repo-map/check.cjs",
    "repo-map:repomix": "node scripts/repo-map/generate.cjs --repomix-only",
    "repo-map:repomix-zones": "node scripts/repo-map/generate.cjs --repomix-zones-only",
    "repo-map:app": "node scripts/repo-map/generate.cjs --repomix-zone app",
    "repo-map:components": "node scripts/repo-map/generate.cjs --repomix-zone components",
    "repo-map:server": "node scripts/repo-map/generate.cjs --repomix-zone server",
    "repo-map:scripts": "node scripts/repo-map/generate.cjs --repomix-zone scripts",
    "repo-map:config": "node scripts/repo-map/generate.cjs --repomix-zone config",
    "repo-map:deps": "node scripts/repo-map/generate.cjs --deps-only",
    "repo-map:ast": "node scripts/repo-map/generate.cjs --ast-only",
    "repo-map:summary": "node scripts/repo-map/generate.cjs --summary-only",
    "postinstall": "prisma generate && patch-package && node scripts/copy-duckdb-wasm.cjs"
  },
