{
  "permissions": {
    "allow": [
      "Bash(powershell -Command:*)",
      "Bash(powershell.exe *)",
      "Bash(Get-Content *)",
      "Bash(Select-String *)",
      "Bash(Select-Object *)",
      "Bash(rg *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm.cmd run *)",
      "Bash(npm.cmd test *)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(tasklist:*)",
      "Bash(taskkill:*)",
      "Bash(netstat:*)",
      "Bash(findstr *)",
      "Bash(curl:*)",
      "Bash(railway status *)",
      "Bash(railway logs *)",
      "Bash(railway deployment *)",
      "Bash(railway deployments *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.secrets)",
      "Read(*.secrets.json)",
      "Bash(*RAILWAY_TOKEN=*)",
      "Bash(*DIRECT_URL=*)",
      "Bash(*DATABASE_URL=*postgresql://*)",
      "Bash(*PGPASSWORD=*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking git/build safety"
          }
        ]
      }
    ]
  }
}
